    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-modules-core": "^3.0.30",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10"
  },
